# Copia este archivo como .env y cambia la URL por tu sitio WordPress.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Puerto local donde nginx publica Django en Docker.
DJANGO_HTTP_PORT=8001

# WordPress queda separado en infra/wordpress.
# Si Django corre en Docker, deja vacio para usar http://host.docker.internal:8080.
# Si Django corre local sin Docker, usa http://127.0.0.1:8080.
WORDPRESS_BASE_URL=

# Cantidad de posts que se muestran en el home.
WORDPRESS_POSTS_PER_PAGE=9

# En desarrollo conviene 0 para ver cambios de WordPress al refrescar.
WORDPRESS_CACHE_SECONDS=0
